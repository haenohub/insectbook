{
  "name": "search-insectbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "predev": "node scripts/build-web-data.mjs",
    "build": "node scripts/build-web-data.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "node --test --test-isolation=none tests/web-*.test.mjs",
    "test:e2e": "playwright test",
    "prepare:images": "node scripts/prepare-web-images.mjs",
    "verify:build": "node scripts/verify-web-build.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "sharp": "^0.35.5"
  }
}
